{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2018",
		"allowJs": false,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"strict": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"lib": ["DOM", "DOM.Iterable", "ES2018", "ES2021.String"]
	},
	"include": ["src/**/*.ts"]
}
